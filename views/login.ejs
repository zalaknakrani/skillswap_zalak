
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="theme-color" content="#0b1020">
    <meta name="description" content="Log in to Skill Swap and connect with people to exchange skills.">
    <title>Login | Skill Swap</title>
    <link rel="stylesheet" href="/css/auth.css">
    <script src="/js/auth.js" defer></script>
</head>
<body>
    <main class="auth-layout">
        <section class="brand-panel">
            <a class="brand" href="/login">
                <span class="brand-icon">S</span>
                <span>skill<span class="brand-accent">swap</span></span>
            </a>

            <div class="brand-content">
                <span class="eyebrow"><span class="live-dot"></span> LEARN. SHARE. GROW.</span>
                <h1>Your skills are<br>worth <span>sharing.</span></h1>
                <p>
                    Connect with people who know what you want to learn
                    and teach someone something you love.
                </p>

                <div class="exchange-card">
                    <div class="avatar-stack">
                        <span class="avatar avatar-one">J</span>
                        <span class="avatar avatar-two">A</span>
                        <span class="avatar avatar-three">R</span>
                    </div>
                    <div>
                        <strong>Learn together</strong>
                        <p>Real people. Real skills. No money needed.</p>
                    </div>
                    <span class="exchange-symbol">↗</span>
                </div>
            </div>

            <div class="brand-footer">
                <span>© <%= new Date().getFullYear() %> Skill Swap</span>
                <span>Built for curious minds.</span>
            </div>
        </section>

        <section class="form-panel">
            <div class="mobile-brand">
                <span class="brand-icon">S</span>
                <span>skill<span class="brand-accent">swap</span></span>
            </div>

            <div class="auth-card">
                <div class="form-heading">
                    <span class="eyebrow">WELCOME BACK</span>
                    <h2>Good to see you.</h2>
                    <p>Enter your details to continue your journey.</p>
                </div>

                <div class="auth-tabs">
                    <a class="auth-tab active" href="/login">Log in</a>
                    <a class="auth-tab" href="/register">Create account</a>
                </div>

                <form id="loginForm">
                    <div class="field">
                        <label for="email">Email address</label>
                        <input
                            id="email"
                            name="email"
                            type="email"
                            placeholder="you@example.com"
                            autocomplete="email"
                            required>
                    </div>

                    <div class="field">
                        <div class="label-row">
                            <label for="password">Password</label>
                            <button class="text-button" type="button"
                                    data-toggle-password="password">
                                Show
                            </button>
                        </div>
                        <input
                            id="password"
                            name="password"
                            type="password"
                            placeholder="Enter your password"
                            autocomplete="current-password"
                            required>
                    </div>

                    <div class="forgot-row">
                        <a href="/forgot-password">Forgot password?</a>
                    </div>

                    <p class="form-message" id="formMessage"
                       role="status" aria-live="polite"></p>

                    <button class="primary-button" id="submitButton" type="submit">
                        <span>Log in to your account</span>
                        <span aria-hidden="true">→</span>
                    </button>
                </form>

                <div class="form-bottom">
                    New to Skill Swap?
                    <a href="/register">Create a free account</a>
                </div>

                <p class="security-note">
                    <span aria-hidden="true">✦</span>
                    Your learning journey starts here.
                </p>
            </div>
        </section>
    </main>
</body>
</html>
